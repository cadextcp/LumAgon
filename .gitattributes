# BBC BASIC auf dem Agon erwartet CRLF in Quelldateien und MOS-Skripten.
* text=auto
*.bas text eol=crlf
*.bat text eol=crlf
/sdcard/autoexec.txt text eol=crlf
# Binaere Tabellen (matrix.map) nie umwandeln
*.map binary
# STL-Exporte (gehaeuse/): Zeilenenden nicht anfassen, sonst Diff-Rauschen
*.stl binary
